{
  "name": "ci-cd-optimizer",
  "version": "0.2.0",
  "private": true,
  "description": "Dependabot for CI/CD performance: a configurable linter, GitHub App, and Action that finds and fixes build and release bottlenecks.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ci-cd-optimizer": "dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:ui": "tsc -p ui/setup/tsconfig.json --noEmit",
    "build:ui": "node scripts/build-setup-ui.mjs",
    "check:ui": "node scripts/build-setup-ui.mjs --check",
    "bundle": "esbuild src/action.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist-action/index.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --legal-comments=none",
    "cli": "tsx src/bin.ts",
    "docs:rules": "tsx src/bin.ts rules --format markdown --output docs/rules.md",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "setup": "node scripts/setup.mjs",
    "mcp": "node mcp/setup-server.mjs",
    "preview:mcp": "node test/setup/preview-host.mjs",
    "test:setup": "node --test test/setup/*.node.mjs",
    "test": "npm run test:setup && vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "postgres": "^4.0.0",
    "probot": "^14.3.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/core": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.65.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
