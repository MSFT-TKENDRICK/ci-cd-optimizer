{
  "name": "ci-cd-optimizer",
  "version": "0.2.0",
  "private": true,
  "description": "Dependabot for CI/CD performance: a configurable linter, GitHub App, and Action that finds and fixes build and release bottlenecks.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ci-cd-optimizer": "dist/bin.js",
    "cicd-lint": "dist/lint-bin.js",
    "cicd-mcp": "dist/mcp-bin.js",
    "cicd-acp": "dist/acp-bin.js"
  },
  "files": [
    "dist",
    "plugins/ci-cd-optimizer",
    "action.yml",
    "formal",
    "docs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "scripts": {
    "build": "npm run build:dashboard && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:ui": "tsc -p ui/setup/tsconfig.json --noEmit",
    "typecheck:dashboard": "tsc -p ui/dashboard/tsconfig.json --noEmit",
    "build:ui": "node scripts/build-setup-ui.mjs",
    "build:dashboard": "node scripts/build-dashboard-ui.mjs",
    "check:ui": "node scripts/build-setup-ui.mjs --check",
    "bundle": "node scripts/bundle.mjs action",
    "bundle:agents": "node scripts/bundle.mjs agents",
    "ci:prepare": "npm run build:dashboard && npm run assurance:generate && npm run formal:generate && npm run bundle:agents && npm run bundle && npm run build:ui",
    "ci:check-generated": "npm run assurance:check && npm run formal:check && node scripts/build-dashboard-ui.mjs --check && node scripts/bundle.mjs all --check && npm run check:ui",
    "cli": "tsx src/bin.ts",
    "docs:rules": "tsx src/bin.ts rules --format markdown --output docs/rules.md",
    "formal:setup": "node scripts/formal-toolchain.mjs",
    "formal:verify": "node scripts/formal.mjs verify",
    "formal:generate": "node scripts/formal.mjs generate",
    "formal:check": "node scripts/formal.mjs check",
    "formal:check-bundle": "node scripts/check-formal-bundle.mjs",
    "assurance:generate": "tsx scripts/assurance.ts generate",
    "assurance:check": "tsx scripts/assurance.ts check",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:check": "node scripts/run-git-hook.mjs pre-commit",
    "secrets:install": "node scripts/install-gitleaks.mjs",
    "secrets:staged": "node .gitleaks/better-gitleaks staged",
    "secrets:check": "node .gitleaks/better-gitleaks history",
    "start": "node dist/index.js",
    "setup": "node scripts/setup.mjs",
    "mcp": "node mcp/setup-server.mjs",
    "agents:mcp": "tsx src/mcp-bin.ts",
    "agents:acp": "tsx src/acp-bin.ts",
    "preview:mcp": "node test/setup/preview-host.mjs",
    "test:setup": "node --test test/setup/*.node.mjs",
    "test:agents:package": "node scripts/check-agent-package.mjs",
    "test": "npm run test:setup && vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "bignumber.js": "9.3.1",
    "postgres": "^4.0.0",
    "probot": "^14.3.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/core": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@openuidev/react-lang": "^1.1.0",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.65.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
