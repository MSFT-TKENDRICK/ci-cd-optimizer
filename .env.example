APP_ID=123456
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
WEBHOOK_SECRET=replace-me
LOG_LEVEL=info
# HOST defaults to localhost outside the container; the image sets 0.0.0.0 for ingress.
PORT=3000
# Optional hosted ACP; disabled unless explicitly enabled with both authentication and pinned repositories.
# Serve behind TLS and ingress limits. Use actual repository IDs, not these examples. See docs/agents.md.
# CICD_OPTIMIZER_ACP=true
# CICD_OPTIMIZER_ACP_AUTH=github-user
# CICD_OPTIMIZER_ACP_REPOSITORIES=acme/widgets:12345678
# Set WEBHOOK_QUEUE=postgres for durable hosted operation; direct mode is the compatibility default.
# WEBHOOK_QUEUE=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cicd_optimizer
